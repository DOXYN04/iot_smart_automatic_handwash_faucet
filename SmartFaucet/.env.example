# Salin file ini menjadi .env lalu isi nilai aslinya. JANGAN commit .env.
SECRET_KEY=ganti_dengan_string_acak_panjang

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_database

# Kosongkan jika Telegram belum dipakai; notifikasi hanya akan dicetak di konsol.
